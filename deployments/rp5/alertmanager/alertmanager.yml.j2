global:
  resolve_timeout: 5m

templates:
  - '/etc/alertmanager/templates/*.tmpl'

route:
  receiver: 'telegram'
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: 'telegram'
    telegram_configs:
      - bot_token: '{{ rp5_telegram_bot_token }}'
        chat_id: {{ rp5_telegram_chat_id }}
        send_resolved: true
        parse_mode: 'HTML'
        message: '{% raw %}{{ template "telegram.text" . }}{% endraw %}'

